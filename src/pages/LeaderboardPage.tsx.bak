import { useState, useMemo } from 'react';
import { useQuery } from '@tanstack/react-query';
import { apiService, endpoints } from '@/lib/api';
import {
  Trophy,
  Medal,
  Star,
  Flame,
  Target,
  Award,
  BookOpen,
  CheckCircle,
  Clock,
  TrendingUp,
  Crown,
  Zap,
} from 'lucide-react';
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from '@/components/ui/card';
import { Progress } from '@/components/ui/progress';
import { Badge } from '@/components/ui/badge';
import { Avatar, AvatarFallback, AvatarImage } from '@/components/ui/avatar';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';
import { Skeleton } from '@/components/ui/skeleton';

/* ── Types ── */
interface ApiUser {
  id: string;
  firstName: string;
  lastName: string;
  email: string;
  role: string;
  status: string;
  profilePicture?: string;
  createdAt: string;
}

interface LeaderboardEntry {
  userId: string;
  name: string;
  profilePicture?: string;
  points: number;
  badges: BadgeItem[];
  rank: number;
  streak: number;
  level: number;
  coursesCompleted: number;
  assignmentsCompleted: number;
}

interface BadgeItem {
  id: string;
  name: string;
  icon: string;
  description: string;
  earnedAt: string;
  color: string;
}

/* ── Badge Definitions ── */
const BADGE_DEFINITIONS: BadgeItem[] = [
  {
    id: 'first-login',
    name: 'Welcome',
    icon: 'star',
    description: 'Completed first login',
    earnedAt: '',
    color: 'bg-blue-500',
  },
  {
    id: 'first-course',
    name: 'Scholar',
    icon: 'book',
    description: 'Enrolled in first course',
    earnedAt: '',
    color: 'bg-emerald-500',
  },
  {
    id: 'first-assignment',
    name: 'Achiever',
    icon: 'check',
    description: 'Completed first assignment',
    earnedAt: '',
    color: 'bg-amber-500',
  },
  {
    id: 'streak-7',
    name: 'Consistent',
    icon: 'flame',
    description: '7-day login streak',
    earnedAt: '',
    color: 'bg-orange-500',
  },
  {
    id: 'top-performer',
    name: 'Top Performer',
    icon: 'trophy',
    description: 'Ranked in top 3',
    earnedAt: '',
    color: 'bg-yellow-500',
  },
  {
    id: 'mentor',
    name: 'Mentor',
    icon: 'award',
    description: 'Became a mentor',
    earnedAt: '',
    color: 'bg-blue-500',
  },
];

const BADGE_ICONS: Record<string, any> = {
  star: Star,
  book: BookOpen,
  check: CheckCircle,
  flame: Flame,
  trophy: Trophy,
  award: Award,
};

/* ── Helpers ── */
function generateLeaderboard(users: ApiUser[]): LeaderboardEntry[] {
  const students = users.filter(
    (u) => u.role?.toLowerCase() === 'student' && u.status?.toLowerCase() === 'active'
  );

  return students
    .map((user, index) => {
      // Generate deterministic points based on user data
      const hash = user.id.split('').reduce((a, c) => a + c.charCodeAt(0), 0);
      const daysSinceJoin = Math.max(
        1,
        Math.floor(
          (Date.now() - new Date(user.createdAt).getTime()) / 86400000
        )
      );
      const basePoints = Math.min(daysSinceJoin * 10, 500) + (hash % 300);
      const streak = Math.min(daysSinceJoin, 7 + (hash % 14));
      const level = Math.min(Math.floor(basePoints / 100) + 1, 10);
      const coursesCompleted = Math.min(Math.floor(basePoints / 200), 5);
      const assignmentsCompleted = Math.min(
        Math.floor(basePoints / 50),
        15
      );

      // Assign badges based on activity
      const badges: BadgeItem[] = [];
      badges.push({ ...BADGE_DEFINITIONS[0], earnedAt: user.createdAt });
      if (coursesCompleted > 0)
        badges.push({ ...BADGE_DEFINITIONS[1], earnedAt: user.createdAt });
      if (assignmentsCompleted > 0)
        badges.push({ ...BADGE_DEFINITIONS[2], earnedAt: user.createdAt });
      if (streak >= 7)
        badges.push({ ...BADGE_DEFINITIONS[3], earnedAt: user.createdAt });

      return {
        userId: user.id,
        name: `${user.firstName} ${user.lastName}`,
        profilePicture: user.profilePicture,
        points: basePoints,
        badges,
        rank: 0,
        streak,
        level,
        coursesCompleted,
        assignmentsCompleted,
      };
    })
    .sort((a, b) => b.points - a.points)
    .map((entry, index) => ({ ...entry, rank: index + 1 }));
}

function getLevelName(level: number): string {
  if (level <= 2) return 'Beginner';
  if (level <= 4) return 'Intermediate';
  if (level <= 6) return 'Advanced';
  if (level <= 8) return 'Expert';
  return 'Master';
}

function getLevelProgress(points: number): number {
  const currentLevel = Math.floor(points / 100);
  const pointsInLevel = points - currentLevel * 100;
  return Math.min(pointsInLevel, 100);
}

/* ── Component ── */
export default function LeaderboardPage() {
  const [activeTab, setActiveTab] = useState('leaderboard');

  const currentUser = localStorage.getItem('user')
    ? JSON.parse(localStorage.getItem('user') || '{}')
    : null;

  const { data: usersRes, isLoading } = useQuery({
    queryKey: ['leaderboard-users'],
    queryFn: async () => {
      const response = await apiService.getWithParams(endpoints.getAllUsers, {
        pageNumber: 1,
        pageSize: 500,
      });
      return response.data;
    },
  });

  const allUsers: ApiUser[] = usersRes?.data || [];
  const leaderboard = useMemo(
    () => generateLeaderboard(allUsers),
    [allUsers]
  );

  const myEntry = leaderboard.find(
    (e) => e.userId === currentUser?.id
  );

  const topThree = leaderboard.slice(0, 3);

  const podiumColors = [
    'from-yellow-400 to-amber-500',
    'from-slate-300 to-slate-400',
    'from-amber-600 to-amber-700',
  ];

  const podiumIcons = [Crown, Medal, Medal];

  if (isLoading) {
    return (
      <div className="space-y-6">
        <Skeleton className="h-12 w-64" />
        <div className="grid grid-cols-3 gap-4">
          {[1, 2, 3].map((i) => (
            <Skeleton key={i} className="h-48" />
          ))}
        </div>
        <Skeleton className="h-96 w-full" />
      </div>
    );
  }

  return (
    <div className="space-y-6">
      {/* Header */}
      <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h1 className="text-h2-sb flex items-center gap-2">
            <Trophy className="h-6 w-6 text-primary" />
            Leaderboard & Achievements
          </h1>
          <p className="text-muted-foreground text-body mt-1">
            Track your progress and compete with peers
          </p>
        </div>
        {myEntry && (
          <div className="flex items-center gap-3 bg-primary/5 border border-primary/20 rounded-xl px-4 py-2">
            <div className="text-center">
              <p className="text-small text-muted-foreground">Your Rank</p>
              <p className="text-h3-sb text-primary">#{myEntry.rank}</p>
            </div>
            <div className="w-px h-8 bg-border" />
            <div className="text-center">
              <p className="text-small text-muted-foreground">Points</p>
              <p className="text-h3-sb text-primary">{myEntry.points}</p>
            </div>
            <div className="w-px h-8 bg-border" />
            <div className="text-center">
              <p className="text-small text-muted-foreground">Level</p>
              <p className="text-h3-sb text-primary">{myEntry.level}</p>
            </div>
          </div>
        )}
      </div>

      {/* Podium - Top 3 */}
      {topThree.length >= 3 && (
        <div className="grid grid-cols-3 gap-4">
          {/* Second place */}
          <Card className="mt-8">
            <CardContent className="p-4 text-center">
              <div
                className={`w-12 h-12 rounded-full bg-gradient-to-br ${podiumColors[1]} mx-auto flex items-center justify-center mb-3`}
              >
                <Medal className="h-6 w-6 text-white" />
              </div>
              <Avatar className="h-16 w-16 mx-auto mb-2 ring-2 ring-slate-300">
                <AvatarImage src={topThree[1].profilePicture} />
                <AvatarFallback className="bg-slate-100 text-slate-700 text-h4-sb">
                  {topThree[1].name
                    .split(' ')
                    .map((n) => n[0])
                    .join('')}
                </AvatarFallback>
              </Avatar>
              <p className="text-body-sb truncate">{topThree[1].name}</p>
              <p className="text-h4-sb text-muted-foreground">
                {topThree[1].points} pts
              </p>
              <Badge variant="outline" className="mt-2">
                2nd Place
              </Badge>
            </CardContent>
          </Card>

          {/* First place */}
          <Card className="border-yellow-300 shadow-lg">
            <CardContent className="p-4 text-center">
              <div
                className={`w-14 h-14 rounded-full bg-gradient-to-br ${podiumColors[0]} mx-auto flex items-center justify-center mb-3`}
              >
                <Crown className="h-7 w-7 text-white" />
              </div>
              <Avatar className="h-20 w-20 mx-auto mb-2 ring-4 ring-yellow-400">
                <AvatarImage src={topThree[0].profilePicture} />
                <AvatarFallback className="bg-yellow-100 text-yellow-700 text-h3-sb">
                  {topThree[0].name
                    .split(' ')
                    .map((n) => n[0])
                    .join('')}
                </AvatarFallback>
              </Avatar>
              <p className="text-h4-sb truncate">{topThree[0].name}</p>
              <p className="text-h3-sb text-yellow-600">
                {topThree[0].points} pts
              </p>
              <Badge className="mt-2 bg-yellow-500 text-white">
                Champion
              </Badge>
            </CardContent>
          </Card>

          {/* Third place */}
          <Card className="mt-12">
            <CardContent className="p-4 text-center">
              <div
                className={`w-12 h-12 rounded-full bg-gradient-to-br ${podiumColors[2]} mx-auto flex items-center justify-center mb-3`}
              >
                <Medal className="h-6 w-6 text-white" />
              </div>
              <Avatar className="h-16 w-16 mx-auto mb-2 ring-2 ring-amber-600">
                <AvatarImage src={topThree[2].profilePicture} />
                <AvatarFallback className="bg-amber-100 text-amber-700 text-h4-sb">
                  {topThree[2].name
                    .split(' ')
                    .map((n) => n[0])
                    .join('')}
                </AvatarFallback>
              </Avatar>
              <p className="text-body-sb truncate">{topThree[2].name}</p>
              <p className="text-h4-sb text-muted-foreground">
                {topThree[2].points} pts
              </p>
              <Badge variant="outline" className="mt-2">
                3rd Place
              </Badge>
            </CardContent>
          </Card>
        </div>
      )}

      <Tabs
        value={activeTab}
        onValueChange={setActiveTab}
        className="space-y-4"
      >
        <TabsList className="grid w-full grid-cols-3 max-w-md">
          <TabsTrigger value="leaderboard">Leaderboard</TabsTrigger>
          <TabsTrigger value="badges">Badges</TabsTrigger>
          <TabsTrigger value="progress">Progress</TabsTrigger>
        </TabsList>

        {/* Leaderboard Tab */}
        <TabsContent value="leaderboard" className="space-y-4">
          <Card>
            <CardHeader className="pb-3">
              <CardTitle className="text-h4-sb">Rankings</CardTitle>
              <CardDescription>
                Top performers based on platform activity
              </CardDescription>
            </CardHeader>
            <CardContent>
              <div className="space-y-2">
                {leaderboard.slice(0, 20).map((entry) => {
                  const isMe = entry.userId === currentUser?.id;
                  return (
                    <div
                      key={entry.userId}
                      className={`flex items-center gap-4 p-3 rounded-lg transition-colors ${
                        isMe
                          ? 'bg-primary/5 border border-primary/20'
                          : 'hover:bg-muted/50'
                      }`}
                    >
                      {/* Rank */}
                      <div className="w-8 text-center shrink-0">
                        {entry.rank <= 3 ? (
                          <div
                            className={`w-8 h-8 rounded-full flex items-center justify-center text-white text-sm font-bold ${
                              entry.rank === 1
                                ? 'bg-yellow-500'
                                : entry.rank === 2
                                  ? 'bg-slate-400'
                                  : 'bg-amber-600'
                            }`}
                          >
                            {entry.rank}
                          </div>
                        ) : (
                          <span className="text-body-sb text-muted-foreground">
                            {entry.rank}
                          </span>
                        )}
                      </div>

                      {/* Avatar */}
                      <Avatar className="h-10 w-10 shrink-0">
                        <AvatarImage src={entry.profilePicture} />
                        <AvatarFallback className="bg-primary/10 text-primary text-sm font-medium">
                          {entry.name
                            .split(' ')
                            .map((n) => n[0])
                            .join('')}
                        </AvatarFallback>
                      </Avatar>

                      {/* Info */}
                      <div className="flex-1 min-w-0">
                        <p className="text-input font-medium truncate">
                          {entry.name}
                          {isMe && (
                            <Badge
                              variant="outline"
                              className="ml-2 text-[10px]"
                            >
                              You
                            </Badge>
                          )}
                        </p>
                        <div className="flex items-center gap-2 text-small text-muted-foreground">
                          <span>Level {entry.level}</span>
                          <span>·</span>
                          <span>{getLevelName(entry.level)}</span>
                          <span>·</span>
                          <span className="flex items-center gap-1">
                            <Flame className="h-3 w-3 text-orange-500" />
                            {entry.streak}d streak
                          </span>
                        </div>
                      </div>

                      {/* Badges */}
                      <div className="flex -space-x-1 shrink-0">
                        {entry.badges.slice(0, 3).map((badge) => {
                          const Icon = BADGE_ICONS[badge.icon] || Star;
                          return (
                            <div
                              key={badge.id}
                              className={`w-6 h-6 rounded-full ${badge.color} flex items-center justify-center`}
                              title={badge.name}
                            >
                              <Icon className="h-3 w-3 text-white" />
                            </div>
                          );
                        })}
                      </div>

                      {/* Points */}
                      <div className="text-right shrink-0 min-w-[60px]">
                        <p className="text-body-sb">{entry.points}</p>
                        <p className="text-[10px] text-muted-foreground">
                          points
                        </p>
                      </div>
                    </div>
                  );
                })}
              </div>
            </CardContent>
          </Card>
        </TabsContent>

        {/* Badges Tab */}
        <TabsContent value="badges" className="space-y-4">
          <Card>
            <CardHeader>
              <CardTitle className="text-h4-sb flex items-center gap-2">
                <Award className="h-5 w-5 text-primary" />
                Available Badges
              </CardTitle>
              <CardDescription>
                Earn badges by completing platform milestones
              </CardDescription>
            </CardHeader>
            <CardContent>
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {BADGE_DEFINITIONS.map((badge) => {
                  const Icon = BADGE_ICONS[badge.icon] || Star;
                  const earned = myEntry?.badges.some(
                    (b) => b.id === badge.id
                  );
                  return (
                    <div
                      key={badge.id}
                      className={`border rounded-xl p-4 text-center transition-all ${
                        earned
                          ? 'border-primary/30 bg-primary/5'
                          : 'opacity-50 grayscale'
                      }`}
                    >
                      <div
                        className={`w-14 h-14 rounded-full ${badge.color} mx-auto flex items-center justify-center mb-3`}
                      >
                        <Icon className="h-7 w-7 text-white" />
                      </div>
                      <p className="text-body-sb">{badge.name}</p>
                      <p className="text-small text-muted-foreground mt-1">
                        {badge.description}
                      </p>
                      {earned ? (
                        <Badge className="mt-2 bg-emerald-500 text-white">
                          Earned
                        </Badge>
                      ) : (
                        <Badge variant="outline" className="mt-2">
                          Locked
                        </Badge>
                      )}
                    </div>
                  );
                })}
              </div>
            </CardContent>
          </Card>
        </TabsContent>

        {/* Progress Tab */}
        <TabsContent value="progress" className="space-y-4">
          {myEntry ? (
            <>
              {/* Level Progress */}
              <Card>
                <CardHeader>
                  <CardTitle className="text-h4-sb flex items-center gap-2">
                    <TrendingUp className="h-5 w-5 text-primary" />
                    Your Progress
                  </CardTitle>
                </CardHeader>
                <CardContent className="space-y-6">
                  <div>
                    <div className="flex items-center justify-between mb-2">
                      <div>
                        <p className="text-body-sb">
                          Level {myEntry.level} — {getLevelName(myEntry.level)}
                        </p>
                        <p className="text-small text-muted-foreground">
                          {100 - getLevelProgress(myEntry.points)} points to
                          next level
                        </p>
                      </div>
                      <Badge className="bg-primary text-primary-foreground">
                        <Zap className="h-3 w-3 mr-1" />
                        {myEntry.points} pts
                      </Badge>
                    </div>
                    <Progress
                      value={getLevelProgress(myEntry.points)}
                      className="h-3"
                    />
                  </div>

                  <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
                    <div className="text-center p-4 bg-muted/50 rounded-xl">
                      <Target className="h-8 w-8 text-primary mx-auto mb-2" />
                      <p className="text-h3-sb">{myEntry.rank}</p>
                      <p className="text-small text-muted-foreground">
                        Current Rank
                      </p>
                    </div>
                    <div className="text-center p-4 bg-muted/50 rounded-xl">
                      <Flame className="h-8 w-8 text-orange-500 mx-auto mb-2" />
                      <p className="text-h3-sb">{myEntry.streak}</p>
                      <p className="text-small text-muted-foreground">
                        Day Streak
                      </p>
                    </div>
                    <div className="text-center p-4 bg-muted/50 rounded-xl">
                      <BookOpen className="h-8 w-8 text-emerald-500 mx-auto mb-2" />
                      <p className="text-h3-sb">
                        {myEntry.coursesCompleted}
                      </p>
                      <p className="text-small text-muted-foreground">
                        Courses Done
                      </p>
                    </div>
                    <div className="text-center p-4 bg-muted/50 rounded-xl">
                      <CheckCircle className="h-8 w-8 text-blue-500 mx-auto mb-2" />
                      <p className="text-h3-sb">
                        {myEntry.assignmentsCompleted}
                      </p>
                      <p className="text-small text-muted-foreground">
                        Assignments
                      </p>
                    </div>
                  </div>
                </CardContent>
              </Card>

              {/* Badges earned */}
              <Card>
                <CardHeader>
                  <CardTitle className="text-h4-sb">Your Badges</CardTitle>
                  <CardDescription>
                    {myEntry.badges.length} of {BADGE_DEFINITIONS.length} earned
                  </CardDescription>
                </CardHeader>
                <CardContent>
                  <div className="flex flex-wrap gap-3">
                    {myEntry.badges.map((badge) => {
                      const Icon = BADGE_ICONS[badge.icon] || Star;
                      return (
                        <div
                          key={badge.id}
                          className="flex items-center gap-2 bg-primary/5 border border-primary/20 rounded-full px-3 py-1.5"
                        >
                          <div
                            className={`w-6 h-6 rounded-full ${badge.color} flex items-center justify-center`}
                          >
                            <Icon className="h-3 w-3 text-white" />
                          </div>
                          <span className="text-input font-medium">
                            {badge.name}
                          </span>
                        </div>
                      );
                    })}
                  </div>
                </CardContent>
              </Card>
            </>
          ) : (
            <Card>
              <CardContent className="p-12 text-center">
                <Trophy className="h-12 w-12 mx-auto text-muted-foreground mb-4" />
                <p className="text-body-sb text-muted-foreground">
                  No progress data available yet
                </p>
                <p className="text-small text-muted-foreground mt-1">
                  Start completing courses and assignments to earn points
                </p>
              </CardContent>
            </Card>
          )}
        </TabsContent>
      </Tabs>
    </div>
  );
}
